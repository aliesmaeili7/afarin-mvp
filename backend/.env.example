# Backend configuration.
#
# Copy to backend/.env and fill in. Values below match the Supabase CLI local
# stack (`supabase start`), so local development works with no edits.

# --- Database --------------------------------------------------------------
# Runtime connection: DML only, no DDL. Created by scripts/bootstrap.py.
DATABASE_URL=postgresql+asyncpg://afarin_app:afarin_app@127.0.0.1:54322/postgres
# Alembic only. Owns the tables.
MIGRATION_DATABASE_URL=postgresql+psycopg://afarin_migrator:afarin_migrator@127.0.0.1:54322/postgres
# Bootstrap only, never read at runtime. The Supabase `postgres` admin role.
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres

AFARIN_MIGRATOR_PASSWORD=afarin_migrator
AFARIN_APP_PASSWORD=afarin_app

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Storage operations only. NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank to derive {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Only needed for older projects still issuing HS256 tokens.
SUPABASE_JWT_SECRET=

# --- Storage ---------------------------------------------------------------
BUCKET_PRODUCT_IMAGES=product-images
BUCKET_BRAND_ASSETS=brand-assets
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=12582912

# --- Anonymous session cookie ----------------------------------------------
ANON_COOKIE_NAME=afarin_anon
# Must be true in production. False only because local dev is plain HTTP.
ANON_COOKIE_SECURE=false
ANON_COOKIE_SAMESITE=lax
ANON_COOKIE_MAX_AGE=2592000
# Leave unset unless the API and frontend sit on different subdomains.
# ANON_COOKIE_DOMAIN=

# --- Behaviour -------------------------------------------------------------
CONTENT_PROVIDER=stub
# CONTENT_PROVIDER=openrouter
IMAGE_PROVIDER=stub
# IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-5-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=16384
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=Afarin
IMAGE_MODEL=bytedance-seed/seedream-4.5
# Educational posts only. Advertising keeps IMAGE_MODEL / Seedream.
EDUCATIONAL_IMAGE_MODEL=openai/gpt-image-2
# Chat Orchestrator. Empty = LLM_MODEL.
# CHAT_ORCHESTRATOR_MODEL=openai/gpt-5-mini
# Chat-only general image. Do not reuse IMAGE_MODEL / Seedream.
GENERAL_IMAGE_MODEL=openai/gpt-image-2
# CREATIVE_AGENT_MODEL=openai/gpt-5-mini
# EDUCATIONAL_AGENT_MODEL=openai/gpt-5-mini
MAX_CREATIVE_ATTEMPTS_PER_CAMPAIGN=3
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_RETRIES=1
# Phase 1 spent ~14.7s on the progress screen. Set to 0 for instant generation.
GENERATION_SIMULATED_MS=14700
GENERATION_QUEUE_MS=900
ALLOW_FAILURE_INJECTION=false
# Exact origins. A wildcard is invalid once cookies are sent with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
