# Frontend configuration.
#
# Copy to frontend/.env.local. Everything here is compiled into the browser
# bundle, so only publishable values belong in this file. The Supabase
# service-role key must never appear here — it lives in backend/.env.

# "mock" keeps Phase 1 running with no backend at all.
# "http" talks to the FastAPI backend.
NEXT_PUBLIC_API_MODE=http

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth only. Every database read and storage object goes through FastAPI.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable ("anon") key. Safe to ship; it grants nothing on its own
# because every table has RLS enabled with no policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
